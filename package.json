{
  "name": "real-time-collaborative-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tests.json",
    "build": "npm run build --workspaces",
    "start:e2e": "concurrently -k -n server,web \"npm run start -w apps/server\" \"npm run start -w apps/web\"",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test:cluster:packaged": "vitest run --config vitest.packaged.config.ts",
    "benchmark:build": "tsc -p tsconfig.benchmark.json",
    "benchmark:smoke": "npm run benchmark:build && node .benchmark-dist/benchmarks/run.js --suite smoke",
    "benchmark:full": "npm run benchmark:build && node .benchmark-dist/benchmarks/run.js --suite full",
    "benchmark:summarize": "npm run benchmark:build && node .benchmark-dist/benchmarks/summarize.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
