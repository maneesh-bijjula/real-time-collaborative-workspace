DATABASE_URL=postgres://workspace:workspace-local@localhost:5433/workspace
REDIS_URL=redis://localhost:6380
REDIS_PREFIX=commonplace
REDIS_RECONCILE_INTERVAL_MS=2000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=4000
# Browser-facing values may be set in apps/web/.env.local before building.
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:4000/collaboration

# Optional metrics access; use a separate random secret, never a share token.
# METRICS_TOKEN=<output of: openssl rand -hex 32>
# Single trusted edge: overwrite X-Forwarded-For; restrict backend network access.
TRUSTED_PROXY_CIDRS=
MAX_CONNECTIONS=512
MAX_CONNECTIONS_PER_IP=128
MAX_OPEN_DOCUMENTS=128
MAX_DOCUMENT_CLIENTS=128
MAX_DOCUMENT_BYTES=4194304
