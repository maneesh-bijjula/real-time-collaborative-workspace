# Copy to .env.release; keep secrets outside version control.
# Hex passwords avoid URL-reserved characters in the Compose DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
POSTGRES_DB=workspace
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=4000
WEB_PORT=3000
METRICS_TOKEN=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_SECRET
REDIS_PREFIX=commonplace-production
ALLOWED_ORIGINS=https://commonplace.example.com
NEXT_PUBLIC_API_URL=https://commonplace.example.com
NEXT_PUBLIC_COLLABORATION_URL=wss://commonplace.example.com/collaboration
# Set to the exact trusted edge peer CIDR(s), after checking network placement.
TRUSTED_PROXY_CIDRS=
# Set before building; use the full Git commit SHA for all application images.
SOURCE_REVISION=REPLACE_WITH_GIT_COMMIT_SHA
COMMONPLACE_SERVER_IMAGE=commonplace-server:REPLACE_WITH_GIT_COMMIT_SHA
COMMONPLACE_WEB_IMAGE=commonplace-web:REPLACE_WITH_GIT_COMMIT_SHA
